<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MoreUseResources.Core</RootNamespace>
    <AssemblyName>MoreUseResources.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MoreUseResources.Tests" />
    <!-- The Linux benchmark drives the same discovery code as the mod. This attribute is only
         emitted into MoreUseResources.Core.dll; the shipped mod DLL compiles these sources itself. -->
    <InternalsVisibleTo Include="MoreUseResources.Benchmarks" />
  </ItemGroup>
</Project>
